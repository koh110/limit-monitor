# Dashboard(Node.js 配信サービス)の EnvironmentFile。
# 配置例: /etc/limit-monitor/dashboard.env
# 通常は `sudo ./deploy.ts --server` が未作成時にこの example から初期配置する
# (既存ファイルは上書きしない)。手動で置く場合:
#   sudo install -d -m 755 /etc/limit-monitor
#   sudo install -m 644 deploy/dashboard.env.example /etc/limit-monitor/dashboard.env
#
# systemd unit は ExecStart の引数で ${INSTALL_DIR} を展開するため、
# 配置先を /opt へ固定せずここで切り替えられる。

# release 配置先(deploy.sh の INSTALL_DIR と一致させる)
INSTALL_DIR=/var/www/limit-monitor

# bind address。既定は localhost のみ。
# LAN の他端末から見せる場合は 0.0.0.0 か LAN 側の address を明示する。
# public Internet へは公開しない(SECURITY.md)。
HOST=127.0.0.1

# listen port。同一ホストの他サービスと衝突しない値にする
# (Hub は 8787 を使う)
PORT=8788

# ブラウザがアクセスする public origin(CORS 検証用)。HOST は bind address
# でありブラウザが送る origin ではないため分離する。
# - localhost 既定 bind (HOST=127.0.0.1) の場合は未設定でもよい
#   (deploy.sh は http://127.0.0.1:8788 を導出する)
# - LAN bind (HOST=0.0.0.0 等) では必須。ブラウザが実際に送る origin
#   (例: http://limit-monitor.local:3000) を設定する
# 未設定のまま LAN bind にすると deploy.sh は fail-closed で止まる。
# DASHBOARD_PUBLIC_ORIGIN=http://limit-monitor.local:3000

# 配信する静的ファイルの root。既定は ExecStart の
# dist/server から見た dist/public なので通常は設定不要。
# DASHBOARD_DIST_DIR=/var/www/limit-monitor/current/packages/client/dist/public
