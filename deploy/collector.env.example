# Collector の EnvironmentFile。配置例: /etc/limit-monitor/collector.env
#   sudo install -m 640 deploy/collector.env.example /etc/limit-monitor/collector.env
#
# token はこのファイルへ書かない。systemd LoadCredential 経由で注入する。

# release 配置先(deploy.sh の INSTALL_DIR と一致させる)
INSTALL_DIR=/var/www/limit-monitor

HUB_URL=http://127.0.0.1:8787

# 既定は real。fixture 送信は COLLECTOR_MODE=mock を明示した場合だけ有効になる
COLLECTOR_MODE=real

# tokenに紐付くsourceIdはHub側で保存時の基準にする。ここは表示・観測用の任意ラベル。
# accountAlias は token 発行時に Hub 側へ紐付くため collector では設定しない。
SOURCE_ID=dev-machine

# 送信間隔(秒)。0 なら 1 回送信して終了する(unit は Type=oneshot に
# render される)。既定の 60 は常駐(Type=simple)
COLLECTOR_INTERVAL_SECONDS=60

# 送信する provider(comma 区切り: codex,claude)。未知の名前は起動時に失敗する
COLLECTOR_PROVIDERS=codex,claude

# vendor CLI の絶対 path。systemd 配下は PATH が細いため明示する。
# collector は install user(= deploy を実行した通常ユーザー)として動くため、
# そのアカウントの login shell 経由で解決した絶対 path を入れる:
#   runuser -u <install-user> -- <user_shell> -lc 'command -v -- codex'
#   runuser -u <install-user> -- <user_shell> -lc 'command -v -- claude'
# 例: CODEX_BIN=/home/<install-user>/.nvm/versions/node/v26/bin/codex
# --install-systemd は current 切替前に install user として実行可能であることを
# 検証するため、存在しない / 実行不可能な値は deploy で失敗する(fail-closed)。
CODEX_BIN=/usr/local/bin/codex
CLAUDE_BIN=/usr/local/bin/claude

# vendor CLI 実行の有限 timeout と stdout 上限
COLLECTOR_COMMAND_TIMEOUT_MS=60000
COLLECTOR_MAX_STDOUT_BYTES=1048576
