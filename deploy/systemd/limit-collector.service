# Limit Monitor Collector systemd unit template (Phase 1: mock collector)
# 配置例: /etc/systemd/system/limit-collector.service
# token は平文 env ではなく systemd credential で注入する:
#   sudo install -m 600 /dev/stdin /etc/limit-monitor/collector-token <<< '<token>'
[Unit]
Description=Limit Monitor Collector (mock)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=limit-monitor
Group=limit-monitor
WorkingDirectory=/opt/limit-monitor/packages/collector
Environment=HUB_URL=http://127.0.0.1:8787
# token を発行した sourceId と一致させる(hostname を自動送信しない)
Environment=SOURCE_ID=dev-machine
Environment=ACCOUNT_ALIAS=default
Environment=COLLECTOR_INTERVAL_SECONDS=60
Environment=COLLECTOR_PROVIDERS=codex,claude
LoadCredential=hub-token:/etc/limit-monitor/collector-token
Environment=HUB_TOKEN_FILE=%d/hub-token
ExecStart=/usr/bin/node dist/src/index.js
Restart=always
RestartSec=10

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
