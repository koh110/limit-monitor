# Limit Hub systemd unit template
# 配置例: /etc/systemd/system/limit-hub.service
# リポジトリ配置先(/opt/limit-monitor)と DB path は環境に合わせて置き換える
[Unit]
Description=Limit Monitor Hub (Codex/Claude usage limit aggregator)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 専用ユーザーでの実行を推奨: useradd --system --home /var/lib/limit-monitor limit-monitor
User=limit-monitor
Group=limit-monitor
WorkingDirectory=/opt/limit-monitor/packages/hub
Environment=APP_ENV=production
Environment=PORT=8787
Environment=DB_FILE_PATH=/var/lib/limit-monitor/limit-monitor.sqlite
# 起動時に migration が自動適用される
ExecStart=/usr/bin/node dist/src/index.js
Restart=always
RestartSec=5

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/limit-monitor

[Install]
WantedBy=multi-user.target
