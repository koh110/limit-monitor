# Limit Hub の EnvironmentFile。配置例: /etc/limit-monitor/hub.env
# 通常は `sudo ./deploy.ts --server` が未作成時にこの example から初期配置する
# (既存ファイルは上書きしない)。手動で置く場合:
#   sudo install -d -m 755 /etc/limit-monitor
#   sudo install -m 644 deploy/hub.env.example /etc/limit-monitor/hub.env
#
# systemd unit は ExecStart の引数で ${INSTALL_DIR} を展開するため、
# 配置先を /opt へ固定せずここで切り替えられる。

# release 配置先(deploy.sh の INSTALL_DIR と一致させる)
INSTALL_DIR=/var/www/limit-monitor

APP_ENV=production
PORT=8787

# SQLite DB の絶対 path。unit の StateDirectory=limit-monitor が
# /var/lib/limit-monitor を「deploy を実行した通常ユーザー(install user)」の
# 所有・mode 0755 で用意するため、既定ではその配下に置く。limit-monitor という
# 名前はディレクトリ名であって Linux ユーザー名ではない(専用ユーザーは作らない)。
# 別の場所へ置く場合は unit の drop-in で ReadWritePaths を追加すること。
DB_FILE_PATH=/var/lib/limit-monitor/limit-monitor.sqlite

# Dashboard の origin を明示列挙する(production では `*` と未設定は起動時に失敗する)。
# ブラウザが実際に送る origin と一致させる必要がある(完全一致で照合されるので
# port まで書く)。localhost 既定 bind なら http://127.0.0.1:8788、LAN bind
# (HOST=0.0.0.0 等) なら dashboard.env の DASHBOARD_PUBLIC_ORIGIN と一致させる。
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8788
