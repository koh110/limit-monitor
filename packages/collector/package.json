{
  "name": "collector",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "start": "node dist/src/index.js",
    "tsc": "tsc --build tsconfig.test.json",
    "vitest": "vp test --config=./vite.config.ts",
    "test": "npm run tsc && npm run test-ci",
    "test-ci": "vp test run --config=./vite.config.ts --maxWorkers=1",
    "format": "vp fmt package.json src --write",
    "format-check": "vp fmt package.json src --check",
    "lint": "vp lint src",
    "lint-fix": "vp lint src --fix"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "concurrently": "^9.2.4",
    "typescript": "^6.0.3"
  }
}
