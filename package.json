{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "vp lint deploy.ts && npm run lint --workspaces --if-present",
    "format": "vp fmt package.json deploy.ts --write && npm run format --workspaces --if-present",
    "format-check": "vp fmt package.json deploy.ts --check",
    "tsc": "tsc --build tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "predev:dashboard": "npm run build -w shared",
    "dev:dashboard": "npm run dev -w dashboard",
    "predev:hub": "npm run build -w shared",
    "dev:hub": "npm run dev -w hub"
  },
  "dependencies": {
    "vite-plus": "^0.1.24"
  }
}
