# === hub (packages/hub) ===
# 実行環境: production | test | local
APP_ENV=local
# Limit Hub の listen port
PORT=8787
# SQLite DB ファイルの配置先(永続 volume に置くこと)
DB_FILE_PATH=./data/limit-monitor.sqlite
# Dashboard の origin(カンマ区切り)。production では `*` と未設定を拒否する
CORS_ALLOWED_ORIGINS=http://localhost:5173

# === dashboard (packages/client) ===
# Dashboard(browser)から見た Hub の base URL。
# Vite の static build に焼き込まれるため、build 前に設定すること。
VITE_HUB_BASE_URL=http://127.0.0.1:8787

# --- 本番配信 server(packages/client/dist/server/index.js)---
# Dashboard は Node.js 常駐サービスとして dist/public を配信する。
# Hub とは別 service / 別 EnvironmentFile(deploy/dashboard.env.example)で設定するため、
# ここでは Hub の PORT と衝突しないようコメントアウトしてある。
# bind address。既定は 127.0.0.1。LAN へ出す場合だけ明示的に変える
# HOST=127.0.0.1
# listen port(既定 8788)。他サービスと同居できるよう必ず変更できる
# PORT=8788
# 配信する静的ファイルの root(既定: dist/server から見た ../public)
# DASHBOARD_DIST_DIR=

# === collector (packages/collector) ===
# 動作モード: real | mock。既定は real(未設定なら real)。
# mock は fixture を送信するため、明示的に指定した場合だけ有効。
# real / mock 以外の値は起動時にエラーになる。
COLLECTOR_MODE=real
# 送信先 Hub の base URL
HUB_URL=http://127.0.0.1:8787
# collector token(開発用。運用では HUB_TOKEN_FILE を使う)
HUB_TOKEN=
# collector token を格納したファイルの path(systemd LoadCredential 用)
HUB_TOKEN_FILE=
# この端末の別名(hostname の自動送信はしない)
SOURCE_ID=dev-machine
# accountAlias は token 発行時にHubへ紐付けるため、collectorには設定しない
# 送信間隔(秒)。0 なら 1 回送信して終了する
COLLECTOR_INTERVAL_SECONDS=0
# 送信する provider(comma 区切り: codex,claude)。未知の名前は起動時にエラー
COLLECTOR_PROVIDERS=codex,claude
# service の実行ユーザーを指定する環境変数は無い。deploy 時に install user
# (sudo -E の SUDO_USER、または現在のユーザー)を自動解決して 3 unit へ揃える。
# 旧 COLLECTOR_USER / COLLECTOR_GROUP は廃止済みで、設定されていると deploy が止まる。
# vendor CLI の実行 path(systemd 配下は PATH が細いため絶対 path を推奨)
CLAUDE_BIN=claude
CODEX_BIN=codex
# vendor CLI 実行の有限 timeout(ms)
COLLECTOR_COMMAND_TIMEOUT_MS=60000
# vendor CLI の stdout 上限(bytes)
COLLECTOR_MAX_STDOUT_BYTES=1048576
