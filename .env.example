# === hub (packages/hub) ===
# 実行環境: production | test | local
APP_ENV=local
# Limit Hub の listen port
PORT=8787
# SQLite DB ファイルの配置先(永続 volume に置くこと)
DB_FILE_PATH=./data/limit-monitor.sqlite

# === client (packages/client) ===
# Dashboard(server side)から見た Hub の base URL
HUB_BASE_URL=http://127.0.0.1:8787

# === collector (packages/collector) ===
# 送信先 Hub の base URL
HUB_URL=http://127.0.0.1:8787
# collector token(開発用。運用では HUB_TOKEN_FILE を使う)
HUB_TOKEN=
# collector token を格納したファイルの path(systemd LoadCredential 用)
HUB_TOKEN_FILE=
# この端末の別名(hostname の自動送信はしない)
SOURCE_ID=dev-machine
# アカウントの別名(非機密。生のアカウントIDは禁止)
ACCOUNT_ALIAS=default
# 送信間隔(秒)。0 なら 1 回送信して終了する
COLLECTOR_INTERVAL_SECONDS=0
# 送信する provider(comma 区切り: codex,claude)
COLLECTOR_PROVIDERS=codex,claude
